.tab-bar{position:fixed;left:0;right:0;bottom:0;z-index:50;box-sizing:border-box;display:flex;align-items:center;justify-content:space-around;height:calc(112rpx + env(safe-area-inset-bottom));padding:6rpx 10rpx calc(6rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dfe6ed;background:#fff}
.tab-item::after{border:0}.tab-bar .tab-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;flex:1;width:0;min-width:0;height:100rpx;min-height:max(100rpx,44px);margin:0;padding:0;border:0;border-radius:0;background:transparent;color:#526578;font-size:22rpx;font-weight:400;line-height:1}.tab-bar .tab-item.selected{color:#23569a;font-weight:500}.tab-icon{width:38rpx;height:38rpx}
