.badge{display:inline-flex;align-items:center;gap:5rpx;padding:5rpx 12rpx;border-radius:10rpx;white-space:nowrap;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:22rpx;font-weight:500;line-height:1.4;background:#edf1f5;color:#526578}.badge image{width:25rpx;height:25rpx}.training{color:var(--training);background:var(--training-soft)}.friendly{color:var(--friendly);background:var(--friendly-soft)}.pickup{color:var(--pickup);background:var(--pickup-soft)}
