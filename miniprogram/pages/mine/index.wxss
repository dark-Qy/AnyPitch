.mine-page{background:var(--canvas);min-height:100vh}.mine-content{padding:0}.profile-hero{padding:28rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);background:#fff;color:var(--ink)}.profile-main{display:flex;align-items:center;gap:20rpx;min-height:120rpx}.profile-avatar{width:110rpx;height:110rpx;flex-shrink:0;border-radius:50%;overflow:hidden;background:var(--primary-soft);color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:500}.profile-avatar image{width:100%;height:100%}.profile-identity{min-width:0;flex:1}.profile-name{font-family:var(--title-font);font-size:36rpx;font-weight:500;overflow-wrap:anywhere}.profile-status{display:flex;align-items:center;color:var(--muted);font-size:24rpx;margin-top:8rpx}.profile-status image{width:24rpx;height:24rpx}button.edit-link:not([size="mini"]){display:flex;align-items:center;justify-content:center;gap:4rpx;width:auto;min-height:max(88rpx,44px);flex-shrink:0;padding:18rpx 12rpx;margin:0;background:transparent;color:var(--primary);font-size:24rpx}.edit-link image{width:24rpx;height:24rpx}.training-stat{display:flex;align-items:baseline;gap:32rpx;margin:24rpx 0 0;padding:16rpx 20rpx;background:var(--surface-muted);border-radius:16rpx;color:var(--muted)}.training-number{font-family:"DIN Alternate","Arial Narrow",var(--body-font);font-size:68rpx;font-style:italic;font-weight:800;letter-spacing:-3rpx;line-height:1;color:var(--primary)}.training-stat-label{font-size:26rpx;font-weight:500;line-height:1.4}.mine-menu{margin:16rpx 0 0;background:#fff;overflow:hidden}.mine-menu button.menu-item:not([size="mini"]){display:flex;align-items:center;gap:18rpx;width:100%;min-height:max(100rpx,44px);background:#fff;padding:20rpx 0;margin:0;color:var(--ink);text-align:left;font-size:28rpx;border-bottom:1rpx solid var(--line)}.menu-icon-box{width:42rpx;height:42rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}.menu-icon-box image{width:34rpx;height:34rpx}.menu-chevron{width:26rpx;height:26rpx;flex-shrink:0}.mine-activity .section-heading{margin:24rpx 0 8rpx}.mine-activity .section-heading button{display:flex;align-items:center;gap:4rpx}.mine-activity .section-heading button image{width:24rpx;height:24rpx}.record{display:flex;align-items:center;gap:14rpx;min-height:144rpx;padding:18rpx 0;border-bottom:1rpx solid var(--line);flex-wrap:wrap}.record-cover{width:76rpx;height:76rpx;flex-shrink:0}.record-body{flex:1;min-width:0}.record-title{font-family:var(--title-font);font-size:28rpx;font-weight:500;overflow-wrap:anywhere}.record-meta{display:flex;align-items:flex-start;gap:6rpx;font-size:22rpx;color:var(--muted);line-height:1.5}.record-meta image{width:23rpx;height:23rpx;flex-shrink:0;margin-top:4rpx}.record-badge{border-radius:10rpx;padding:5rpx 10rpx;font-size:20rpx}.record-badge.is-ended,.record-badge.is-other{background:var(--surface-muted);color:var(--muted)}.record-badge.is-registered{background:var(--primary-soft);color:var(--training)}.record-chevron{width:24rpx;height:24rpx}.history-empty{padding:34rpx;color:var(--muted);text-align:center;font-size:26rpx}
.edit-backdrop{position:fixed;inset:0;z-index:100;background:rgba(20,40,60,.45);display:flex;align-items:flex-end}.edit-sheet{width:100%;max-height:90vh;overflow-y:auto;background:#fff;border-radius:24rpx 24rpx 0 0;padding:12rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx)}.sheet-handle{width:76rpx;height:6rpx;border-radius:6rpx;background:var(--line);margin:0 auto 20rpx}.sheet-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;font-family:var(--title-font);font-size:34rpx;font-weight:500}.sheet-heading button:not([size="mini"]){width:max(88rpx,44px);height:max(88rpx,44px);min-height:max(88rpx,44px);background:transparent;padding:26rpx;margin:0}.sheet-heading image{width:32rpx;height:32rpx}.editor-avatar{position:relative;width:160rpx;height:160rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--primary-soft);color:var(--ink);font-size:56rpx;margin:0 auto}.editor-avatar>image{width:100%;height:100%;border-radius:50%}button.camera-button:not([size="mini"]){position:absolute;right:-16rpx;bottom:-12rpx;width:max(88rpx,44px);height:max(88rpx,44px);min-height:max(88rpx,44px);padding:26rpx;margin:0;border-radius:50%;background:var(--primary);border:3rpx solid #fff}.camera-button image{width:30rpx;height:30rpx}button.change-avatar:not([size="mini"]),button.local-avatar:not([size="mini"]){width:auto;margin:12rpx auto 0;padding:20rpx 12rpx;min-height:max(88rpx,44px);background:transparent;color:var(--primary);font-size:25rpx}.profile-form{margin-top:16rpx}.name-field{display:flex;align-items:center;gap:16rpx;font-size:28rpx}.name-field>text{width:70rpx;flex-shrink:0}.name-input{display:flex;align-items:center;flex:1;border:1rpx solid var(--line);border-radius:16rpx;padding:0 14rpx;min-width:0;min-height:max(96rpx,44px)}.name-input input{border:0;margin:0;padding:16rpx 0;min-height:94rpx;flex:1;min-width:0}.name-input image{width:28rpx;height:28rpx;flex-shrink:0}.sheet-error{font-size:24rpx;color:#a52835;margin-top:12rpx}button.save-button:not([size="mini"]){width:100%;margin:28rpx 0 0;min-height:max(88rpx,44px);background:var(--primary);color:#fff;font-size:28rpx;font-weight:500}
.avatar-status{text-align:center;color:var(--muted);font-size:23rpx;line-height:1.5;margin:4rpx 0 14rpx}
.notification-copy{display:flex;flex-direction:column;gap:4rpx}.notification-subtitle{font-size:21rpx;color:var(--muted);font-weight:400}.notification-status{padding:12rpx 0;color:var(--muted);font-size:22rpx;line-height:1.5}.mine-menu button.menu-item[disabled]{opacity:.6}
