.member-page{min-height:100vh;background:#fff;padding-top:60rpx}.member-profile{display:flex;flex-direction:column;align-items:center}.portrait:not([size="mini"]){display:flex;align-items:center;justify-content:center;width:260rpx;height:260rpx;min-height:0;margin:0;padding:0;border-radius:50%;background:var(--primary-soft);color:var(--primary);font-family:var(--title-font);font-size:94rpx;overflow:hidden}.portrait image{width:100%;height:100%}.portrait[disabled]{opacity:1}.member-name{margin-top:26rpx;font-family:var(--title-font);font-size:42rpx;font-weight:500;overflow-wrap:anywhere;text-align:center}.member-caption{font-size:24rpx;color:var(--muted);margin-top:6rpx}.member-divider{width:100%;border-top:1rpx solid var(--line);margin:52rpx 0 28rpx}.member-stat{display:flex;align-items:center;justify-content:space-between;width:100%;font-size:26rpx}.member-stat>view{display:flex;align-items:baseline;gap:6rpx;white-space:nowrap}.member-count{font-size:42rpx;font-weight:600;color:var(--training)}.member-note{align-self:stretch;margin-top:14rpx;font-size:22rpx;color:var(--muted)}
