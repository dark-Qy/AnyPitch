<view class="page events-page">
  <team-brand/>
  <view class="event-tabs"><button class="{{mode === 'current' ? 'active' : ''}}" data-value="current" bindtap="changeMode"><image src="/assets/icons/check-calendar-dark.svg"/><text>当前活动</text></button><button class="{{mode === 'history' ? 'active' : ''}}" data-value="history" bindtap="changeMode"><image src="/assets/icons/history-dark.svg"/><text>历史活动</text></button></view>
  <view class="type-tabs"><button wx:for="{{types}}" wx:key="value" class="{{type === item.value ? 'selected' : ''}}" data-kind="type" data-value="{{item.value}}" bindtap="chooseQuick"><text>{{item.label}}</text></button></view>
  <view wx:if="{{dropdown}}" class="quick-backdrop" catchtap="closeDropdown"></view>
  <view class="filter-area"><view class="filter-bar"><button class="filter-choice" data-kind="place" bindtap="toggleDropdown"><image src="/assets/icons/pin-dark.svg"/><text>{{placeLabel}}</text><image class="dropdown-icon" src="/assets/icons/chevron-dark.svg"/></button><button class="filter-trigger" bindtap="openFilter" aria-label="筛选活动"><image src="/assets/icons/filter-dark.svg"/><text>筛选</text></button></view><view wx:if="{{dropdown}}" class="quick-menu"><button wx:for="{{places}}" wx:key="value" class="quick-option {{place === item.value ? 'selected' : ''}}" data-kind="place" data-value="{{item.value}}" bindtap="chooseQuick"><text>{{item.label}}</text><image wx:if="{{place === item.value}}" src="/assets/icons/check-dark.svg"/></button></view></view>
  <view class="list-caption"><text class="serif">{{mode === 'history' ? '历史活动' : '近期活动'}}</text><text>{{loading && !events.length ? "加载中" : error && !events.length ? "暂不可用" : visible.length + " 场"}}</text></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
  <view wx:if="{{loading && !visible.length}}" class="loading">加载中…</view>
  <view wx:elif="{{!visible.length && !error}}" class="quiet-empty">{{mode === 'history' ? '没有符合筛选条件的历史活动' : '近期暂无符合筛选条件的活动'}}</view>
  <view wx:else class="activity-list"><view class="activity-row" wx:for="{{visible}}" wx:key="id" wx:for-item="event" data-id="{{event.id}}" bindtap="open" aria-role="button" aria-label="查看{{event.title}}详情">
    <image class="activity-symbol" src="{{event.typeIcon}}" mode="aspectFit"/>
    <view class="activity-body"><view class="activity-heading"><type-badge type="{{event.type}}"/><text wx:if="{{mode === 'history'}}" class="ended-tag">{{event.cancelled ? '已取消' : '已结束'}}</text></view><view class="activity-title">{{event.title}}</view><view class="activity-meta"><image src="/assets/icons/calendar-dark.svg"/><text>{{event.timeText}}</text></view><view class="activity-meta"><image src="/assets/icons/pin-dark.svg"/><text>{{event.location || '地点待定'}}</text></view>
      <view class="activity-footer"><view class="attendee-group"><view class="avatar-stack"><view wx:for="{{event.attendeePreview}}" wx:key="id" class="avatar-dot"><image wx:if="{{item.avatarPath}}" src="{{item.avatarPath}}" mode="aspectFill"/><text wx:else>{{item.initial}}</text></view><text wx:if="{{event.attendeeExtra > 0}}" class="avatar-dot avatar-extra">+{{event.attendeeExtra}}</text></view><text class="attendee-count">{{event.attendeeCount === 0 || event.attendeeCount ? event.attendeeCount + ' 人已报名' : event.previewFailed ? '报名情况暂不可用' : '报名情况加载中'}}</text></view>
        <button class="event-action {{mode === 'history' ? 'secondary' : event.status === 'available' ? 'registered' : ''}}" data-id="{{event.id}}" catchtap="open"><image wx:if="{{mode === 'current' && event.status === 'available'}}" src="/assets/icons/check-dark.svg"/><text>{{mode === 'history' ? '详情' : event.status === 'available' ? '已报名' : '报名'}}</text><image wx:if="{{mode === 'history' || event.status !== 'available'}}" src="{{mode === 'history' ? '/assets/icons/chevron-dark.svg' : '/assets/icons/chevron-light.svg'}}"/></button>
      </view>
    </view>
  </view></view>
  <button class="topics-link" bindtap="topics"><image src="/assets/icons/trophy-dark.svg"/><text class="grow">赛事专题</text><image src="/assets/icons/chevron-dark.svg"/></button>
  <view wx:if="{{filterOpen}}" class="filter-backdrop" catchtap="closeFilter"><view class="filter-sheet" catchtap="stop"><view class="sheet-handle"></view><view class="filter-title"><text>筛选活动</text><view class="filter-title-actions"><button bindtap="resetFilter">重置</button><button class="filter-close" bindtap="closeFilter" aria-label="关闭筛选"><image src="/assets/icons/close-dark.svg"/></button></view></view><view class="filter-label">活动地点</view><view class="filter-options"><button wx:for="{{places}}" wx:key="value" class="{{draftPlace === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="choosePlace">{{item.label}}</button></view><view class="filter-label">活动类型</view><view class="filter-options"><button wx:for="{{types}}" wx:key="value" class="{{draftType === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="chooseType">{{item.label}}</button></view><button class="apply-button primary" bindtap="applyFilter">查看 {{draftCount}} 场活动</button></view></view>
</view>
