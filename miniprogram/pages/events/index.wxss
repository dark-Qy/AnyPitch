.events-page{padding:0 28rpx calc(144rpx + env(safe-area-inset-bottom));background:var(--canvas)}.event-tabs{display:flex;border-bottom:1rpx solid var(--line)}.event-tabs button:not([size="mini"]){position:relative;display:flex;align-items:center;justify-content:center;gap:12rpx;width:50%;min-height:max(96rpx,44px);margin:0;padding:20rpx 6rpx;background:transparent;color:var(--muted);font-family:var(--body-font);font-weight:500;font-size:30rpx}.event-tabs button.active{color:var(--training)}.event-tabs button.active:after{content:"";position:absolute;bottom:0;left:20%;right:20%;height:5rpx;border-radius:4rpx;background:var(--training)}.event-tabs image{width:34rpx;height:34rpx}.type-tabs{display:flex;gap:4rpx;padding:8rpx 0;border-bottom:1rpx solid var(--line)}.type-tabs button:not([size="mini"]){display:flex;align-items:center;justify-content:center;gap:8rpx;flex:1;width:0;min-width:0;min-height:max(88rpx,44px);margin:0;padding:12rpx 2rpx;background:transparent;font-size:25rpx;font-weight:400;white-space:nowrap}.type-tabs button.selected{background:var(--primary-soft);color:var(--training);font-weight:500}
.type-tabs image{width:30rpx;height:30rpx;flex-shrink:0}.filter-area{position:relative;z-index:12}.filter-bar{display:flex;justify-content:space-between;align-items:center;min-height:max(96rpx,44px);border-bottom:1rpx solid var(--line)}.filter-bar button:not([size="mini"]){display:flex;align-items:center;justify-content:center;gap:8rpx;width:auto;min-height:max(88rpx,44px);margin:0;background:transparent;padding:16rpx 10rpx;font-size:25rpx}.filter-bar image{width:30rpx;height:30rpx}.filter-choice .dropdown-icon{width:24rpx;height:24rpx;transform:rotate(90deg)}.quick-backdrop{position:fixed;inset:0;z-index:11;background:rgba(20,40,60,.12)}.quick-menu{position:absolute;top:94rpx;left:0;width:300rpx;padding:10rpx;background:#fff;border:1rpx solid var(--line);border-radius:16rpx}.quick-option:not([size="mini"]){display:flex;align-items:center;justify-content:space-between;width:100%;min-height:max(88rpx,44px);margin:0;padding:20rpx 16rpx;background:#fff;font-size:26rpx}.quick-option.selected{background:var(--primary-soft);color:var(--training)}.quick-option image{width:28rpx;height:28rpx}.list-caption{margin:0;padding:10rpx 0}.list-caption .serif{font-size:32rpx;color:var(--ink)}
.activity-row{display:flex;gap:18rpx;padding:26rpx 0;border-bottom:1rpx solid var(--line)}.activity-symbol{width:96rpx;height:108rpx;flex-shrink:0;align-self:center}.activity-body{min-width:0;flex:1}.activity-heading{display:flex;align-items:center;justify-content:space-between;gap:8rpx}.activity-title{font-family:var(--title-font);font-size:32rpx;font-weight:500;line-height:1.45;margin:8rpx 0;overflow-wrap:anywhere}.activity-meta{display:flex;align-items:flex-start;gap:8rpx;color:var(--muted);font-size:24rpx;line-height:1.55;margin:4rpx 0}.activity-meta image{width:26rpx;height:26rpx;flex-shrink:0;margin-top:5rpx}.activity-meta text{min-width:0;overflow-wrap:anywhere}.activity-footer{display:flex;align-items:center;justify-content:space-between;gap:10rpx;flex-wrap:wrap;margin-top:14rpx}.attendee-group{display:flex;align-items:center;gap:10rpx;min-width:0}.avatar-stack{display:flex;align-items:center;padding-left:10rpx;flex-shrink:0}.avatar-dot{width:42rpx;height:42rpx;margin-left:-10rpx;border:3rpx solid #fff;border-radius:50%;background:#dce8f3;color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:18rpx;overflow:hidden}.avatar-dot image{width:100%;height:100%}.avatar-extra{background:#edf1f5;font-size:16rpx}.attendee-count{font-size:21rpx;color:var(--muted);white-space:nowrap}.event-action:not([size="mini"]){display:flex;align-items:center;justify-content:center;gap:5rpx;width:auto;min-height:max(88rpx,44px);margin:0;padding:16rpx 18rpx;background:var(--primary);color:#fff;font-size:25rpx;flex-shrink:0}.event-action image{width:25rpx;height:25rpx}.event-action.registered{background:var(--primary-soft);color:var(--training)}.event-action.secondary{background:var(--surface-muted);color:var(--ink)}.ended-tag{font-size:20rpx;color:var(--muted);background:var(--surface-muted);padding:4rpx 8rpx;border-radius:8rpx}.topics-link:not([size="mini"]){display:flex;align-items:center;gap:12rpx;background:transparent;margin:16rpx 0 0;padding:20rpx 0;text-align:left}.topics-link image{width:30rpx;height:30rpx}.quiet-empty{margin:16rpx 0}
.filter-backdrop{position:fixed;inset:0;z-index:100;background:rgba(20,40,60,.45);display:flex;align-items:flex-end}.filter-sheet{width:100%;max-height:90vh;overflow-y:auto;padding:12rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);border-radius:24rpx 24rpx 0 0;background:#fff}.sheet-handle{width:70rpx;height:6rpx;margin:0 auto 20rpx;border-radius:6rpx;background:var(--line)}.filter-title{display:flex;align-items:center;justify-content:space-between;font-family:var(--title-font);font-size:34rpx}.filter-title-actions{display:flex;align-items:center;font-family:var(--body-font);font-weight:500}.filter-title button:not([size="mini"]){width:auto;min-height:max(88rpx,44px);margin:0;padding:18rpx;background:transparent;font-size:24rpx;font-family:var(--body-font);font-weight:500}.filter-close image{width:32rpx;height:32rpx}.filter-label{margin:20rpx 0 12rpx;font-size:26rpx;font-weight:500}.filter-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.filter-options button:not([size="mini"]){display:flex;align-items:center;justify-content:center;gap:8rpx;width:100%;min-width:0;min-height:max(88rpx,44px);margin:0;padding:16rpx 8rpx;border:1rpx solid transparent;background:var(--surface-muted);font-size:25rpx}.filter-options button.selected{border-color:var(--training);background:var(--primary-soft);color:var(--training)}.apply-button{margin:28rpx 0 0}
@media(max-width:350px){.events-page{padding-left:22rpx;padding-right:22rpx}.activity-row{gap:12rpx}.activity-symbol{width:76rpx;height:94rpx}.activity-title{font-size:30rpx;font-family:var(--title-font);font-weight:500}.attendee-count{font-size:20rpx}.event-action:not([size="mini"]){padding-left:14rpx;padding-right:14rpx}}

.filter-close{min-width:44px}
.avatar-stack{padding-left:0;margin-left:-10px;margin-right:-10px}.avatar-stack .avatar-tap{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin-left:-29px;flex-shrink:0}.avatar-stack .avatar-tap:first-child{margin-left:0}.avatar-stack .avatar-dot{margin-left:0}
.list-caption{gap:8rpx}.list-caption-actions{display:flex;align-items:center;justify-content:flex-end;gap:16rpx;flex-shrink:0}.list-caption .calendar-toggle{display:flex;align-items:center;justify-content:center;width:auto;min-width:88rpx;min-height:44px;margin:0;padding:0 4rpx;border:0;background:transparent;color:var(--training);font-size:23rpx;font-weight:500;white-space:nowrap}
.month-calendar{margin:0 0 12rpx;padding:14rpx 12rpx 18rpx;border:1rpx solid var(--line);border-radius:16rpx;background:#fff}.calendar-toolbar,.calendar-title,.calendar-nav{display:flex;align-items:center}.calendar-toolbar{justify-content:space-between;margin-bottom:4rpx}.calendar-title{gap:8rpx;min-width:0;font-family:var(--title-font);font-size:28rpx;font-weight:500}.calendar-title>text{white-space:nowrap}.calendar-title button.calendar-today:not([size="mini"]){width:auto;min-width:44px;min-height:44px;flex-shrink:0;margin:0;padding:8rpx 12rpx;background:transparent;color:var(--training);font-family:var(--body-font);font-size:22rpx}.calendar-nav{gap:4rpx;flex-shrink:0}.calendar-nav .month-nav-button{width:44px;height:44px;min-height:44px;margin:0;padding:0;background:transparent;color:var(--training);font-size:38rpx;line-height:1}.calendar-weekdays,.calendar-week{display:flex;align-items:center;width:100%;height:44px}.calendar-weekdays{height:32px}.calendar-weekday,.calendar-cell{box-sizing:border-box;width:0;flex:1;min-width:0}.calendar-weekday{text-align:center;font-size:21rpx;color:var(--muted);padding:8rpx 0}.calendar-cell{height:44px}.month-calendar .calendar-day{position:relative;display:flex;align-items:center;justify-content:center;width:100%;height:44px;margin:0;padding:4rpx 0;border-radius:12rpx;background:transparent;color:var(--ink);font-size:25rpx;font-weight:400}.month-calendar .calendar-day.today{color:var(--training);font-weight:600}.month-calendar .calendar-day.selected{background:var(--primary-soft);color:var(--training);font-weight:600}.month-calendar .calendar-day:active{background:var(--surface-muted)}.month-calendar .calendar-day.has-event:after{content:"";position:absolute;bottom:4px;left:calc(50% - 3rpx);width:6rpx;height:6rpx;border-radius:50%;background:var(--training)}
@media(max-width:350px){.calendar-title{font-size:25rpx}.calendar-title .calendar-today{padding-left:6rpx;padding-right:6rpx}.month-calendar{margin-left:-8rpx;margin-right:-8rpx;padding-left:8rpx;padding-right:8rpx}}
