.rsvp-page{padding:0 28rpx calc(144rpx + env(safe-area-inset-bottom));min-height:100vh;background:var(--canvas)}.rsvp-heading{padding:24rpx 0;border-top:1rpx solid var(--line)}.rsvp-list{display:flex;flex-direction:column;gap:18rpx}.rsvp-card{padding:24rpx;background:#fff;border:1rpx solid var(--line);border-radius:18rpx}.rsvp-top{display:flex;align-items:center;justify-content:space-between}.rsvp-top button{display:flex;align-items:center;gap:4rpx}.rsvp-top image{width:24rpx;height:24rpx}.rsvp-title{font-family:var(--title-font);font-size:34rpx;font-weight:500;line-height:1.4;margin:14rpx 0;overflow-wrap:anywhere}.rsvp-meta{display:flex;gap:8rpx;align-items:flex-start;color:var(--muted);font-size:24rpx;line-height:1.5;margin:5rpx 0}.rsvp-meta image{width:26rpx;height:26rpx;flex-shrink:0;margin-top:4rpx}.rsvp-choices{display:flex;gap:6rpx;margin-top:20rpx}.rsvp-choices button:not([size="mini"]){display:flex;align-items:center;justify-content:center;flex:1;width:0;min-width:0;min-height:max(88rpx,44px);margin:0;padding:10rpx 0;background:var(--surface-muted);color:var(--ink);font-size:23rpx}.rsvp-choices button.selected{background:var(--primary);color:#fff}.rsvp-choices button[disabled]{opacity:.65}
