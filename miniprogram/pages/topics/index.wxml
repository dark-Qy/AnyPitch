<view class="page player-page"><view class="player-heading"><view class="title">赛事专题</view></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{loading}}" class="loading">加载中…</view><view wx:elif="{{!topics.length && !error}}" class="quiet-empty">暂无赛事专题</view><block wx:else><view class="topic" wx:for="{{topics}}" wx:key="id" wx:for-item="topic"><view class="row"><text class="topic-title grow">{{topic.name}}</text><text class="badge">{{topic.status === 'active' ? '进行中' : '已归档'}}</text></view><view class="small muted topic-date">{{topic.starts_on}} — {{topic.ends_on}}</view><view wx:if="{{topic.summary}}" class="content small">{{topic.summary}}</view><view class="schedule-item" wx:for="{{topic.entries}}" wx:key="id"><view class="small muted">{{item.timeText}}</view><view class="schedule-title">{{item.title}}</view><view wx:if="{{item.location}}" class="small muted">{{item.location}}</view><view wx:if="{{item.opponent}}" class="opponent"><text>对阵 {{item.opponent}}</text><text class="score">{{item.scoreText}}</text></view><view wx:if="{{item.notes}}" class="content small">{{item.notes}}</view></view></view></block></view>
