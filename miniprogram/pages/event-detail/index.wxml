<view class="detail-page" wx:if="{{event}}">
  <view class="detail-hero"><view class="detail-overlay"><view class="detail-action-row"><view class="detail-type-info"><type-badge type="{{event.type}}"/><text wx:if="{{event.format}}" class="small muted">{{event.format}}人制</text></view><button wx:if="{{!event.ended && !event.cancelled}}" class="share-event" open-type="share"><image src="/assets/icons/invite-dark.svg"/><text>邀请参加</text></button></view><view class="detail-title">{{event.title}}</view><view class="detail-meta"><image src="/assets/icons/calendar-dark.svg"/>{{event.timeText}}</view><view class="detail-meta"><image src="/assets/icons/pin-dark.svg"/>{{event.location || '地点待定'}}</view><view wx:if="{{event.opponent}}">对手 · {{event.opponent}}</view></view></view>
  <canvas canvas-id="event-share-canvas" class="share-canvas"/>
  <view class="detail-sheet">
    <view class="section-label">活动内容</view><view class="notes">{{event.notes || '暂无补充内容'}}</view>
    <view class="divider"/><view class="section-label">我要参加</view><view wx:if="{{!profileComplete}}" class="profile-prompt"><text>完善昵称后即可报名，活动内容可继续查看</text><button bindtap="completeProfile">完善资料 <image src="/assets/icons/chevron-light.svg"/></button></view><view wx:else class="choices"><button wx:for="{{statuses}}" wx:key="value" class="{{event.status === item.value ? 'selected' : ''}}" data-status="{{item.value}}" bindtap="rsvp" disabled="{{saving || event.cancelled || event.ended}}">{{item.label}}</button></view>
    <view class="section-heading"><text>参与情况</text><text class="small muted">共 {{confirmed.length + others.length}} 人</text></view>
    <view class="roster-columns"><view class="roster-column confirmed"><view class="roster-title">确认参加 <text>{{confirmed.length}}</text></view><view wx:if="{{!confirmed.length}}" class="small muted roster-empty">暂无</view><view class="member" wx:for="{{confirmed}}" wx:key="player_id" data-id="{{item.player_id}}" bindtap="openMember" aria-role="button" aria-label="查看{{item.name}}资料"><view class="avatar"><image wx:if="{{item.avatarPath}}" src="{{item.avatarPath}}" mode="aspectFill"/><text wx:else>{{item.initial}}</text></view><text class="member-name">{{item.name}}</text></view></view><view class="roster-column"><view class="roster-title">其他状态 <text>{{others.length}}</text></view><view wx:if="{{!otherGroups.length}}" class="small muted roster-empty">暂无</view><view class="other-group" wx:for="{{otherGroups}}" wx:key="status"><view class="group-label {{item.status}}">{{item.label}} {{item.members.length}}</view><view class="member-chips"><view class="member-chip" wx:for="{{item.members}}" wx:key="player_id" data-id="{{item.player_id}}" bindtap="openMember" aria-role="button" aria-label="查看{{item.name}}资料"><view class="avatar"><image wx:if="{{item.avatarPath}}" src="{{item.avatarPath}}" mode="aspectFill"/><text wx:else>{{item.initial}}</text></view><text class="member-name">{{item.name}}</text></view></view></view></view></view>
  </view>
</view>
<view class="page" wx:else><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:else class="loading">加载中…</view></view>
