.detail-page{padding:24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));background:#fff}.detail-hero{padding-bottom:24rpx;border-bottom:1rpx solid var(--line)}.detail-overlay{font-size:26rpx;line-height:1.6}.manage-link:not([size="mini"]){display:flex;align-items:center;justify-content:center;width:auto;min-height:max(88rpx,44px);margin:0;padding:18rpx;background:var(--surface-muted);color:var(--primary);font-size:24rpx}.detail-overlay .row>button.manage-link{flex:0 0 auto}.detail-title{font-family:var(--title-font);font-size:40rpx;font-weight:500;line-height:1.4;margin:18rpx 0;overflow-wrap:anywhere}.detail-meta{display:flex;align-items:flex-start;gap:10rpx;color:var(--muted);margin:8rpx 0}.detail-meta image{width:28rpx;height:28rpx;flex-shrink:0;margin-top:6rpx}.detail-sheet{padding-top:24rpx}.section-label{font-family:var(--title-font);font-size:32rpx;font-weight:500}.notes{font-size:28rpx;line-height:1.7;margin-top:12rpx;white-space:pre-wrap;color:var(--ink)}.choices{display:flex;gap:8rpx;margin-top:18rpx}.choices button{display:flex;align-items:center;justify-content:center;width:0;flex:1;min-width:0;margin:0;min-height:max(88rpx,44px);padding:16rpx 0;font-size:25rpx}.choices button.selected{background:var(--primary);color:#fff}.choices button[disabled]{opacity:.65}.roster-columns{display:flex;gap:14rpx}.roster-column{width:0;flex:1;background:var(--surface-muted);border-radius:16rpx;padding:16rpx;min-width:0}.roster-title{font-weight:500;font-size:26rpx;margin-bottom:14rpx}.roster-title text{color:var(--training);margin-left:4rpx}.member{display:flex;align-items:center;gap:8rpx;min-height:60rpx}.avatar{width:42rpx;height:42rpx;flex-shrink:0;border-radius:50%;background:#dce8f3;color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:22rpx;overflow:hidden}.avatar image{width:100%;height:100%}.member-name{font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.other-group{margin-bottom:14rpx}.group-label{font-size:23rpx;font-weight:500;color:#97501e}.group-label.unavailable{color:#a13945}.group-label.unknown{color:var(--muted)}.member-chips{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:6rpx}.member-chip{display:flex;align-items:center;gap:6rpx;max-width:100%;padding:4rpx 8rpx 4rpx 4rpx;border-radius:12rpx;background:#fff}.member-chip .avatar{width:35rpx;height:35rpx;font-size:18rpx}.member-chip .member-name{font-size:22rpx}.roster-empty{padding:12rpx 0}.photo-preview{display:flex;gap:8rpx;height:180rpx}.photo-preview image{width:0;flex:1;height:100%;border-radius:12rpx}.album-heading button{display:flex;align-items:center;gap:4rpx}.album-heading button image{width:24rpx;height:24rpx}.album-empty{display:flex;align-items:center;justify-content:center;gap:4rpx;background:var(--surface-muted);color:var(--muted);border-radius:16rpx;min-height:max(88rpx,44px);padding:28rpx 18rpx;text-align:center;font-size:26rpx}.album-empty image{width:24rpx;height:24rpx}.profile-prompt{display:flex;align-items:center;gap:16rpx;margin-top:18rpx;padding:20rpx;border-radius:16rpx;background:var(--primary-soft);color:var(--ink);font-size:24rpx}.profile-prompt text{flex:1;min-width:0}.profile-prompt button:not([size="mini"]){display:flex;gap:4rpx;align-items:center;justify-content:center;width:auto;flex-shrink:0;min-height:max(88rpx,44px);margin:0;padding:16rpx;background:var(--primary);color:#fff;font-size:24rpx}.profile-prompt button image{width:24rpx;height:24rpx}
.detail-action-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:max(88rpx,44px)}
.detail-type-info{display:flex;align-items:center;gap:16rpx;min-width:0}
.detail-action-row button.share-event:not([size="mini"]){display:flex;align-items:center;justify-content:center;gap:8rpx;flex:0 0 auto;width:auto;min-height:max(88rpx,44px);margin:0;padding:0 8rpx;border:0;background:transparent;color:var(--primary);font-size:24rpx;font-weight:500;line-height:1.2;white-space:nowrap}
.share-event image{width:28rpx;height:28rpx;flex-shrink:0}
.share-canvas{position:fixed;left:-2000px;top:0;width:1402px;height:1122px;opacity:0;pointer-events:none}
