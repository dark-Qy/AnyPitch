.stats-page{padding:24rpx 28rpx calc(144rpx + env(safe-area-inset-bottom))}.stats-scene{background:#fff;color:var(--ink);overflow:hidden}.stats-title{font-family:var(--title-font);font-size:42rpx;font-weight:500;margin:12rpx 0 24rpx}.period-controls{display:flex;gap:12rpx}.period-controls picker{flex:1;min-width:0}.period-controls button:not([size="mini"]){display:flex;align-items:center;justify-content:space-between;min-height:max(88rpx,44px);margin:0;padding:18rpx;background:var(--surface-muted);color:var(--ink);font-size:26rpx}.podium{display:flex;align-items:flex-end;justify-content:center;gap:12rpx;height:350rpx;margin-top:20rpx}.podium-person{width:31%;flex:none;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;min-width:0}.podium-person.rank-1{order:2}.podium-person.rank-2{order:1}.podium-person.rank-3{order:3}.podium-symbol{width:26rpx;height:26rpx;margin-bottom:8rpx}.podium-avatar{width:72rpx;height:72rpx;border-radius:50%;border:3rpx solid #dceaf7;background:var(--primary-soft);display:flex;align-items:center;justify-content:center;font-size:28rpx;overflow:hidden}.podium-avatar image,.list-avatar image{width:100%;height:100%;border-radius:50%}.podium-name{font-size:24rpx;font-weight:500;margin-top:8rpx;max-width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.podium-count{font-size:28rpx;font-weight:500;margin-bottom:12rpx;line-height:1.4}.podium-count text{font-size:22rpx;font-weight:400}.podium-step{width:100%;height:64rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx 16rpx 0 0;font-size:34rpx;font-weight:500;color:var(--ink);background:#edf1f5}.rank-1 .podium-step{height:94rpx;color:var(--training);background:#dceaf7}.rank-3 .podium-step{height:54rpx;color:var(--friendly);background:var(--friendly-soft)}.compact-podium{height:auto;min-height:160rpx;flex-direction:column;align-items:stretch;gap:12rpx;padding:20rpx 0}.compact-podium .podium-person{order:initial;width:100%;min-height:max(96rpx,44px);flex-direction:row;justify-content:flex-start;gap:12rpx;padding:14rpx;text-align:left;border-radius:16rpx;background:var(--surface-muted)}.compact-podium .podium-symbol{display:none}.compact-podium .podium-step,.compact-podium .rank-1 .podium-step,.compact-podium .rank-3 .podium-step{order:-1;width:48rpx;height:48rpx;flex-shrink:0;border-radius:50%;font-size:26rpx}.compact-podium .podium-avatar{width:58rpx;height:58rpx;flex-shrink:0}.compact-podium .podium-name{flex:1;margin:0}.compact-podium .podium-count{margin:0;flex-shrink:0}.ranking-list{background:#fff;padding:10rpx 0}.ranking{display:flex;align-items:center;gap:16rpx;padding:20rpx 10rpx;min-height:max(96rpx,44px);border-bottom:1rpx solid var(--line)}.rank{width:38rpx;flex-shrink:0;font-size:26rpx;color:var(--muted);text-align:center}.list-avatar{width:56rpx;height:56rpx;border-radius:50%;background:#dce8f3;color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:24rpx;overflow:hidden}.player-name{font-size:28rpx;overflow-wrap:anywhere}.self-label{color:var(--training);font-size:22rpx;margin-left:10rpx}.count{font-size:30rpx;font-weight:500;flex-shrink:0}.mine{background:var(--primary-soft);border-radius:14rpx}
