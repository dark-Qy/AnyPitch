page{--ink:#203648;--muted:#526578;--line:#dfe6ed;--primary:#203f5b;--primary-soft:#edf4ff;--night:#203648;--highlight:#dceaf7;--canvas:#fff;--surface:#fff;--surface-muted:#f3f6f9;--training:#23569a;--training-soft:#edf4ff;--friendly:#97501e;--friendly-soft:#fff1e5;--pickup:#1d6f5e;--pickup-soft:#e8f6f0;--body-font:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;--title-font:"AnyPitch Serif","Songti SC",serif;background:var(--canvas);color:var(--ink);font-size:28rpx;line-height:1.55;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
view,text,button,input,textarea,image{box-sizing:border-box}.page{padding:24rpx 32rpx calc(144rpx + env(safe-area-inset-bottom))}.title,.section-title,.section-heading,.serif{font-family:var(--title-font);font-weight:500;line-height:1.4}.title{font-size:42rpx;margin:12rpx 0 24rpx;overflow-wrap:anywhere}.section-title{font-size:34rpx;margin:32rpx 0 18rpx}.subtitle,.muted{color:var(--muted)}.subtitle{margin-bottom:24rpx}.small{font-size:24rpx}.grow{flex:1;min-width:0}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.row-start{display:flex;align-items:center;gap:20rpx}.content{white-space:pre-wrap;overflow-wrap:anywhere;margin:20rpx 0}.divider{border-top:1rpx solid var(--line);margin:24rpx 0}
.panel{background:var(--surface);border:1rpx solid var(--line);border-radius:20rpx;padding:26rpx;margin-bottom:24rpx;overflow-wrap:anywhere}.badge{font-size:22rpx;font-weight:500;color:var(--primary);background:var(--primary-soft);padding:6rpx 12rpx;border-radius:10rpx;display:inline-flex;align-items:center}.chevron{width:28rpx;height:28rpx;flex-shrink:0}.icon{width:32rpx;height:32rpx;flex-shrink:0}.inline-icon{display:inline-block;width:28rpx;height:28rpx;vertical-align:middle;margin:0 5rpx}.icon-action{display:flex;align-items:center;justify-content:center;gap:8rpx}.icon-action image{width:30rpx;height:30rpx}
button{font-family:var(--body-font);font-size:28rpx;border-radius:16rpx;min-height:max(88rpx,44px);line-height:1.4;padding:22rpx 24rpx;margin:0;background:var(--surface-muted);color:var(--ink);font-weight:500;transition:background-color .15s ease-out,opacity .15s ease-out}button::after{border:0}button.primary{background:var(--primary);color:#fff}button.danger{color:#a52835;background:#fff0f0}button[disabled]{opacity:.55}button+button{margin-top:16rpx}button.button-hover{opacity:.82}button:not([size="mini"]){width:100%;margin-left:0;margin-right:0}
input,textarea{border:1rpx solid var(--line);border-radius:16rpx;background:#fff;color:var(--ink);padding:22rpx;width:100%;font-size:28rpx;min-height:max(96rpx,44px);margin:12rpx 0 24rpx;font-family:inherit}.placeholder{color:var(--muted)}.error{background:#fff0f0;color:#9c2937;padding:22rpx;border-radius:16rpx;margin:20rpx 0;white-space:pre-wrap}.loading,.empty{padding:52rpx 20rpx;text-align:center;color:var(--muted)}
.logo,.crest{clip-path:polygon(14.8% 18.6%,20% 16.7%,27% 14.7%,35% 12.9%,43% 11.7%,50% 11.3%,57% 11.7%,65% 12.9%,73% 14.7%,80% 16.7%,84.8% 18.6%,84.8% 51%,84.3% 57%,82.9% 63%,80.4% 68.7%,76.9% 74%,72.5% 78.8%,67% 83%,61% 86.5%,55% 89%,50% 90.3%,45% 89%,39% 86.5%,33% 83%,27.5% 78.8%,23.1% 74%,19.6% 68.7%,17.1% 63%,15.7% 57%,14.8% 51%);border-radius:0!important}
.row>picker,.row>button{flex:1;min-width:0}.row button{width:100%;min-width:0;margin-top:0;padding-left:12rpx;padding-right:12rpx}.row>text{overflow-wrap:anywhere}.menu-group{background:#fff;border:1rpx solid var(--line);border-radius:20rpx;overflow:hidden}button.menu-item{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:0;min-height:max(100rpx,44px);padding:22rpx;text-align:left;font-weight:500}button.menu-item+button.menu-item{margin-top:0;border-top:1rpx solid var(--line)}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:36rpx 0 20rpx;font-size:32rpx}.section-heading button{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}button.text-button:not([size="mini"]){width:auto;min-height:max(88rpx,44px);flex-shrink:0;background:transparent;color:var(--primary);font-size:24rpx;padding:20rpx 8rpx;font-weight:500}button.compact:not([size="mini"]){width:auto;min-height:max(88rpx,44px);font-size:26rpx;padding:22rpx}
.player-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:max(96rpx,44px);margin-bottom:18rpx}.player-heading .title{margin:0;font-size:40rpx;min-width:0}.filter-strip{display:flex;gap:8rpx;padding:6rpx;background:var(--surface-muted);border-radius:16rpx}.filter-strip button:not([size="mini"]){width:0;flex:1;min-width:0;min-height:max(88rpx,44px);margin:0;padding:22rpx 4rpx;background:transparent;font-size:26rpx;color:var(--muted);font-weight:500}.filter-strip button.selected{background:var(--night);color:#fff}.list-caption{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:max(88rpx,44px);margin:12rpx 0 6rpx;font-size:26rpx;color:var(--muted)}.quiet-empty{padding:64rpx 24rpx;text-align:center;background:var(--surface-muted);border-radius:20rpx;color:var(--muted);font-size:26rpx;margin-top:20rpx}
.date-tile{width:96rpx;min-height:108rpx;flex-shrink:0;background:var(--primary-soft);border-radius:16rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}.date-tile .month{font-size:22rpx;color:var(--muted)}.date-tile .day{font-size:40rpx;font-weight:500;line-height:1.2}.page-heading{display:flex;align-items:center;gap:12rpx}.page-heading image{width:36rpx;height:36rpx}.page-heading .title{margin:12rpx 0 24rpx}.activity-symbol{width:100rpx;height:100rpx;flex-shrink:0}
@media(prefers-reduced-motion:reduce){button{transition:none}}

.down-icon{transform:rotate(90deg)}
